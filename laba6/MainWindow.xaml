<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="600" Width="800" FontFamily="Arial Black" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Список товаров -->
        <ListBox x:Name="ProductList" Margin="10" SelectionChanged="ProductList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Картинка -->
                            <Image Source="{Binding ImagePath}" Width="140" Height="140" Stretch="Uniform" Grid.Column="0"/>

                            <!-- Текст -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontFamily="Arial" FontSize="12" Margin="0,5,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} Р'}" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Count, StringFormat='Количество: {0}'}" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Добавить" Click="AddButton_Click" Width="120" Height="30" Margin="5"/>
            <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Width="120" Height="30" Margin="5" IsEnabled="False"/>
            <Button x:Name="EditButton" Content="Изменить" Click="EditButton_Click" Width="120" Height="30" Margin="5" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>