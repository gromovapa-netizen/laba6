<Window x:Class="WpfApp.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <TextBlock Text="Название:"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Цена:"/>
        <TextBox x:Name="PriceBox" Margin="0,0,0,10"/>

        <TextBlock Text="Описание:"/>
        <TextBox x:Name="DescBox" Margin="0,0,0,10" Height="60" TextWrapping="Wrap"/>

        <TextBlock Text="Количество:"/>
        <TextBox x:Name="CountBox" Margin="0,0,0,10"/>

        <TextBlock Text="Путь к картинке (например, apple.jpg):"/>
        <TextBox x:Name="ImageBox" Margin="0,0,0,20"/>

        <Button Content="Сохранить" Click="Save_Click" Height="30"/>
    </StackPanel>
</Window>